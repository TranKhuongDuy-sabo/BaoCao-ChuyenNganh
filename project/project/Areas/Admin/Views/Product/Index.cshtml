@model IEnumerable<project.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ti ti-check me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12 d-flex align-items-stretch">
            <div class="card w-100">
                <div class="card-body p-6">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title fw-semibold mb-0">Danh Sách Sản Phẩm</h5>

                        <div class="d-flex gap-2">
                            <form asp-action="Index" asp-controller="Product" asp-area="Admin" method="get" class="d-flex align-items-center">
                                <div class="input-group">
                                    <input type="text" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm sản phẩm..." aria-label="Tìm kiếm" name="search">
                                    <button class="btn btn-outline-success" type="submit">
                                        <i class="ti ti-search fs-4"></i>
                                    </button>
                                    @if (!string.IsNullOrEmpty(ViewBag.Search))
                                    {
                                        <a asp-action="Index" class="btn btn-secondary" title="Xóa lọc">X</a>
                                    }
                                </div>
                            </form>

                            <a href="/Admin/Product/formThem" class="btn btn-primary d-flex align-items-center gap-2">
                                <i class="ti ti-plus fs-4"></i>
                                Thêm Sản Phẩm Mới
                            </a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        @if (TempData["Success"] != null)
                        {
                            <i class="ti ti-check fs-5 me-2"></i>
                            <strong>Thành công!</strong>
                            @TempData["Success"]
                        }
                        <table class="table text-nowrap mb-0 align-middle">
                            <thead class="text-dark fs-4">
                                <tr>
                                    <th>@Html.DisplayNameFor(Model => Model.ProductId)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.ProductName)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Price)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Stock)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Image)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Description)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.CategoryId)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.BrandId)</th>
                                    <th class="border-bottom-0"><h6 class="fw-semibold mb-0">Trạng thái</h6></th>
                                    <th class="border-bottom-0"><h6 class="fw-semibold mb-0">Thao Tác</h6></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ProductId</td>

                                        <td class="fw-bold">@item.ProductName</td>

                                        <td class="text-danger fw-bold">@item.Price.ToString("#,##0") VNĐ</td>

                                        <td>@item.Stock</td>

                                        <td>
                                            <img src="~/images/products/@item.Image" width="50" style="border-radius:5px" alt="No Img" />
                                        </td>

                                        <td>
                                            <span class="d-inline-block text-truncate" style="max-width: 150px;">
                                                @item.Description
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge bg-primary">@item.Category?.CategoryName</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@item.Brand?.BrandName</span>
                                        </td>

                                        <td>
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input class="form-check-input btn-active" type="checkbox"
                                                       data-id="@item.ProductId"
                                                       @(item.IsActive ? "checked" : "")
                                                       style="cursor: pointer;">
                                            </div>
                                        </td>

                                        <td>
                                            <a asp-action="formSua" asp-route-id="@item.ProductId" class="text-primary p-2">
                                                <i class="ti ti-pencil fs-5"></i>
                                            </a>
                                            <a asp-action="formXoa" asp-route-id="@item.ProductId" class="text-danger p-2">
                                                <i class="ti ti-trash fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Bắt sự kiện khi click vào nút gạt có class "btn-active"
            $('.btn-active').change(function () {
                var btn = $(this);
                var id = btn.data('id');        // Lấy ID sản phẩm
                var trangThai = btn.prop('checked'); // Lấy trạng thái (true/false)

                // Gửi Ajax về Server
                $.ajax({
                    url: '/Admin/Product/UpdateStatus', // Đường dẫn tới Controller
                    type: 'POST',
                    data: { id: id, trangThai: trangThai },
                    success: function (rs) {
                        if (rs.success) {
                            console.log('Cập nhật thành công!');
                            // Có thể thêm thông báo Toast lại đây nếu muốn đẹp
                        } else {
                            alert('Có lỗi xảy ra, vui lòng thử lại!');
                            // Nếu lỗi thì gạt nút trở lại vị trí cũ
                            btn.prop('checked', !trangThai);
                        }
                    },
                    error: function () {
                        alert('Lỗi đường truyền!');
                        btn.prop('checked', !trangThai);
                    }
                });
            });
        });
    </script>
}