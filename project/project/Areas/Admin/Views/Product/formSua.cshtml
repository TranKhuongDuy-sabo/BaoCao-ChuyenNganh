@model project.Models.Product;

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="card w-100 border-warning" style="border-top: 3px solid #dc3545;">
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="card-title fw-semibold mb-0 text-warning">
                    <i class="ti ti-edit"></i> Chỉnh Sửa Sản Phẩm
                </h5>
            </div>

            <form asp-action="sua" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="Image" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label fw-bold"></label>
                            <input asp-for="ProductName" class="form-control" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold"></label>
                                <input asp-for="Price" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Stock" class="form-label fw-bold"></label>
                                <input asp-for="Stock" class="form-control" />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BrandId" class="form-label fw-bold"></label>
                            <select asp-for="BrandId" class="form-select" asp-items="ViewBag.BrandId"></select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold"></label>
                            <input type="file" name="imageFile" class="form-control mb-2" accept="image/*" />

                            <div class="p-2 border rounded text-center bg-light">
                                <img src="~/images/products/@Model.Image" style="max-height: 120px; border-radius: 5px;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-warning d-flex align-items-center gap-2">
                        <i class="ti ti-device-floppy fs-4"></i> Lưu Cập Nhật
                    </button>
                    <a asp-action="Index" class="btn btn-light-secondary text-dark d-flex align-items-center gap-2">
                        <i class="ti ti-x fs-4"></i> Hủy Bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}