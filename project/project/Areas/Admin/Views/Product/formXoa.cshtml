@model project.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-8 mx-auto d-flex align-items-stretch">
        <div class="card w-100 border-danger" style="border-top: 3px solid #dc3545;">
            <div class="card-body p-6">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="card-title fw-semibold mb-0 text-danger">
                        <i class="ti ti-alert-triangle me-2"></i> Xác Nhận Xóa Sản Phẩm
                    </h5>
                    <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                        <i class="ti ti-arrow-left fs-4"></i> Quay lại
                    </a>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mb-3">
                        <i class="ti ti-alert-circle"></i> @ViewBag.Error
                    </div>
                }

                <div class="alert alert-warning" role="alert">
                    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa sản phẩm này không? Hành động này không thể hoàn tác!
                </div>

                <div class="mb-4 text-center">
                    <label class="form-label fw-semibold d-block">Hình ảnh</label>
                    <img src="~/images/products/@Model.Image" style="max-height: 150px; border-radius: 8px; border: 1px solid #ddd;" alt="Ảnh sản phẩm" />
                </div>

                <div class="mb-4">
                    <label asp-for="ProductName" class="form-label fw-semibold"></label>
                    <input asp-for="ProductName" class="form-control" readonly disabled style="background-color: #e9ecef;">
                </div>

                <div class="mb-4">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <input value="@Model.Price.ToString("#,##0") VNĐ" class="form-control" readonly disabled style="background-color: #e9ecef;">
                </div>

                <form asp-action="xoa" method="post">

                    <input type="hidden" asp-for="ProductId" name="id" />

                    <div class="d-flex align-items-center gap-2">
                        <button type="submit" class="btn btn-danger d-flex align-items-center gap-2">
                            <i class="ti ti-trash fs-4"></i> Xác Nhận Xóa
                        </button>

                        <a asp-action="Index" class="btn btn-light-secondary text-dark d-flex align-items-center gap-2">
                            <i class="ti ti-x fs-4"></i> Hủy Bỏ
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>