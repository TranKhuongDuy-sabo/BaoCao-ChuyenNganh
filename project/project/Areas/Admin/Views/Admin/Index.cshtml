@model project.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Quản Trị";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title d-flex align-items-center gap-2 mb-4">
                    Tổng quan doanh thu (Demo)
                    <span>
                        <iconify-icon icon="solar:question-circle-bold" class="fs-7 d-flex text-muted" data-bs-toggle="tooltip" data-bs-title="Traffic Overview"></iconify-icon>
                    </span>
                </h5>
                <div id="traffic-overview"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sản phẩm mới nhập</h5>
                <div class="table-responsive">
                    <table class="table text-nowrap align-middle mb-0">
                        <thead>
                            <tr class="border-2 border-bottom border-primary border-0">
                                <th scope="col" class="ps-0">Tên sản phẩm</th>
                                <th scope="col">Danh mục</th>
                                <th scope="col" class="text-center">Giá</th>
                                <th scope="col" class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.NewestProducts != null)
                            {
                                foreach (var item in Model.NewestProducts)
                                {
                                    <tr>
                                        <th scope="row" class="ps-0 fw-medium border-0">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.Image))
                                                {
                                                    <img src="~/images/products/@item.Image" class="rounded-circle me-2" width="40" height="40" style="object-fit: cover;">
                                                }
                                                <span class="table-link1 text-truncate d-block" style="max-width: 200px;">@item.ProductName</span>
                                            </div>
                                        </th>
                                        <td class="border-0">
                                            <span class="badge bg-light text-dark">@item.Category?.CategoryName</span>
                                        </td>
                                        <td class="text-center fw-medium border-0">@item.Price.ToString("#,##0") đ</td>
                                        <td class="text-center border-0">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Hiển thị</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Ẩn</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title d-flex align-items-center gap-2 mb-5 pb-3">
                    Thống kê hệ thống
                </h5>

                <div class="row text-center">
                    <div class="col-4">
                        <iconify-icon icon="solar:laptop-minimalistic-line-duotone" class="fs-7 d-flex text-primary mx-auto"></iconify-icon>
                        <span class="fs-11 mt-2 d-block text-nowrap">Sản phẩm</span>
                        <h4 class="mb-0 mt-1">@Model.TotalProducts</h4>
                    </div>
                    <div class="col-4">
                        <iconify-icon icon="solar:users-group-rounded-line-duotone" class="fs-7 d-flex text-secondary mx-auto"></iconify-icon>
                        <span class="fs-11 mt-2 d-block text-nowrap">Khách hàng</span>
                        <h4 class="mb-0 mt-1">@Model.TotalUsers</h4>
                    </div>
                    <div class="col-4">
                        <iconify-icon icon="solar:tag-line-duotone" class="fs-7 d-flex text-success mx-auto"></iconify-icon>
                        <span class="fs-11 mt-2 d-block text-nowrap">Danh mục</span>
                        <h4 class="mb-0 mt-1">@Model.TotalCategories</h4>
                    </div>
                </div>

                <div class="vstack gap-4 mt-7 pt-2">
                    <div>
                        <div class="hstack justify-content-between">
                            <span class="fs-3 fw-medium">Tổng Sản Phẩm</span>
                            <h6 class="fs-3 fw-medium text-dark lh-base mb-0">@Model.TotalProducts</h6>
                        </div>
                        <div class="progress mt-6" role="progressbar" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 100%"></div>
                        </div>
                    </div>

                    <div>
                        <div class="hstack justify-content-between">
                            <span class="fs-3 fw-medium">Tổng Thương Hiệu</span>
                            <h6 class="fs-3 fw-medium text-dark lh-base mb-0">@Model.TotalBrands</h6>
                        </div>
                        <div class="progress mt-6" role="progressbar" style="height: 6px;">
                            <div class="progress-bar bg-secondary" style="width: 80%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/assets/libs/apexcharts/dist/apexcharts.min.js"></script>
    <script src="~/assets/js/dashboard.js"></script>
}