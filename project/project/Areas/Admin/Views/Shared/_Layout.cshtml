@inject IHttpContextAccessor httpContextAccessor

@{
    // Lấy tên Controller hiện tại đang chạy (Ví dụ: "Category", "Product", "User"...)
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - SaBoTech Admin</title>
    <link rel="stylesheet" href="~/assets/css/styles.css" />
    <link rel="stylesheet" href="~/assets/css/styles.min.css" />

    <style>
        /* ÉP MÀU XANH LÁ CỦA FRUITABLES VÀO TẤT CẢ CÁC THÀNH PHẦN */
        :root,
        [data-bs-theme=light] {
            /* Ghi đè màu chính */
            --bs-primary: #81c408 !important;
            --bs-primary-rgb: 129, 196, 8 !important;
            /* Ghi đè các màu liên quan khác (ví dụ: link, hover nhẹ) */
            --bs-link-color: #81c408 !important;
            --bs-link-hover-color: #6ea706 !important;
            --bs-light-primary: #f4fce3 !important; /* Background xanh lá nhạt */
        }

        /* Ghi đè các class quan trọng để đảm bảo */
        .btn-primary,
        .btn-primary:focus,
        .btn-primary:active {
            background-color: #81c408 !important;
            border-color: #81c408 !important;
            color: #fff !important;
        }

        /* Đảm bảo Sidebar Active (Selected) có màu xanh lá */
        .sidebar-nav ul .sidebar-item.selected > .sidebar-link,
        .sidebar-nav ul .sidebar-item > .sidebar-link.active {
            background-color: #81c408 !important;
            color: #fff !important;
        }

        /* Text và Checkbox */
        .text-primary {
            color: #81c408 !important;
        }

        .form-check-input:checked {
            background-color: #81c408 !important;
            border-color: #81c408 !important;
        }

        .form-control:focus {
            border-color: #81c408 !important;
            box-shadow: 0 0 0 0.25rem rgba(129, 196, 8, 0.25) !important;
        }
        /* CHỈ SỬA: Màu nền mờ khi di chuột vào Menu (Sidebar) */
        .sidebar-nav ul .sidebar-item .sidebar-link:hover,
        .sidebar-nav ul .sidebar-item .sidebar-link:focus {
            /* Đổi nền xanh biển nhạt thành xanh lá nhạt (Fruitables) */
            background-color: rgba(129, 196, 8, 0.1) !important;
            /* Đổi chữ thành màu xanh lá đậm cho đồng bộ */
            color: #81c408 !important;
        }
    </style>
</head>

<body>
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
         data-sidebar-position="fixed" data-header-position="fixed">

        <aside class="left-sidebar">
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between">
                    <!-- SỬ DỤNG HTML THUẦN -->
                    <a href="/Admin/Admin/Index" class="text-nowrap logo-img">
                        <img src="~/assets/images/logos/logo1.png" alt="" style="width: 50%;height: 50%;object-fit: cover;" />
                    </a>
                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
                        <i class="ti ti-x fs-8"></i>
                    </div>
                </div>
                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-6"></i>
                            <span class="hide-menu">QUẢN LÝ</span>
                        </li>

                        <li class="sidebar-item @(currentController == "Admin" ? "selected" : "")">
                            <a class="sidebar-link" href="/Admin/Admin/Index" aria-expanded="false">
                                <span><iconify-icon icon="solar:home-smile-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Dashboard</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "Product" ? "selected" : "")">
                            <a class="sidebar-link" href="/Admin/Product/Index" aria-expanded="false">
                                <span><iconify-icon icon="solar:box-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản Lý Sản Phẩm</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "Category" ? "selected" : "")">
                            <a class="sidebar-link" href="/Admin/Category/Index" aria-expanded="false">
                                <span><iconify-icon icon="solar:folder-with-files-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản Lý Danh Mục</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "Brand" ? "selected" : "")">
                            <a class="sidebar-link" href="/Admin/Brand/Index" aria-expanded="false">
                                <span><iconify-icon icon="solar:tag-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản Lý Thương Hiệu</span>
                            </a>
                        </li>

                        @* <li class="sidebar-item @(currentController == "Order" ? "selected" : "")">
                            <a class="sidebar-link" href="/Admin/Order/Index" aria-expanded="false">
                                <span><iconify-icon icon="solar:cart-check-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản Lý Đơn Hàng</span>
                            </a>
                        </li> *@

                        <li class="sidebar-item @(currentController == "User" ? "selected" : "")">
                            <a class="sidebar-link" href="/Admin/User/Index" aria-expanded="false">
                                <span><iconify-icon icon="solar:users-group-two-rounded-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản Lý Người Dùng</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "ContactInfo" ? "selected" : "")">
                            <a class="sidebar-link" href="/Admin/ContactInfo/Index" aria-expanded="false">
                                <span>
                                    <iconify-icon icon="solar:phone-calling-bold-duotone" class="fs-6"></iconify-icon>
                                </span>
                                <span class="hide-menu">Thông tin liên hệ</span>
                            </a>
                        </li>

                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-6"></i>
                            <span class="hide-menu">KHÁC</span>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <div class="body-wrapper">
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <!-- Loại bỏ các thẻ li bị thiếu (như nav-item d-block d-xl-none) và thay bằng cấu trúc đơn giản hơn -->
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                    </ul>
                    <div class="navbar-collapse justify-content-end px-0 w-100" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">

                            <li class="nav-item me-3 d-none d-sm-block">
                                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-success d-flex align-items-center gap-2 rounded-pill">
                                    <i class="ti ti-world fs-4"></i> Xem Website
                                </a>
                            </li>

                            @{
                                var username = httpContextAccessor.HttpContext.Session.GetString("Username");
                                var fullname = httpContextAccessor.HttpContext.Session.GetString("FullName");
                                var displayName = !string.IsNullOrEmpty(fullname) ? fullname : (!string.IsNullOrEmpty(username) ? username : "Khách");
                            }

                            @if (username != null)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link d-flex align-items-center gap-2" href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown" aria-expanded="false">

                                        <div class="d-none d-sm-block text-end" style="line-height: normal;">
                                            <span class="d-block text-muted" style="font-size: 12px;">Xin chào,</span>
                                            <span class="d-block fw-bold text-dark" style="font-size: 14px;">@displayName</span>
                                        </div>

                                        <img src="~/assets/images/profile/user-1.jpg" alt="" width="35" height="35" class="rounded-circle border border-white">
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2" style="min-width: 200px;">
                                        <div class="message-body">
                                            <div class="d-flex align-items-center py-3 px-4 border-bottom bg-light">
                                                <img src="~/assets/images/profile/user-1.jpg" width="50" height="50" class="rounded-circle">
                                                <div class="ms-3">
                                                    <h5 class="mb-0 fs-3 fw-semibold text-dark">@displayName</h5>
                                                    <span class="text-muted fs-2">Administrator</span>
                                                </div>
                                            </div>

                                            <a href="#" class="d-flex align-items-center gap-2 dropdown-item px-4 py-2 mt-2">
                                                <i class="ti ti-user fs-6"></i>
                                                <p class="mb-0 fs-3">Hồ sơ cá nhân</p>
                                            </a>

                                            <div class="px-4 py-2 mt-2">
                                                <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger w-100">Đăng xuất</a>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item d-flex align-items-center">
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary fs-3 rounded-pill px-4 ms-2">
                                        Đăng nhập
                                    </a>
                                </li>
                            }

                        </ul>
                    </div>
                </nav>
            </header>
            <div class="container-fluid">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

        </div>
    </div>

    <!-- Scripts sử dụng đường dẫn tuyệt đối (~) -->
    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/simplebar/dist/simplebar.js"></script>
    <script src="~/assets/js/sidebarmenu.js"></script>
    <script src="~/assets/js/app.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>