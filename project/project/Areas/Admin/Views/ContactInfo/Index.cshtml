@model project.Models.ContactInfo
@{
    ViewData["Title"] = "Cấu hình thông tin liên hệ";
}

<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 text-white">Quản lý Thông tin Liên hệ (Website)</h5>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <form asp-action="CapNhat" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ hiển thị:</label>
                    <input asp-for="Address" class="form-control" placeholder="Ví dụ: 123 Đường ABC..." />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email liên hệ:</label>
                    <input asp-for="Email" class="form-control" placeholder="Ví dụ: contact@shop.com" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Số điện thoại:</label>
                    <input asp-for="Phone" class="form-control" placeholder="Ví dụ: 0988 888 888" />
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> Lưu Cập Nhật
                </button>
            </form>
        </div>
    </div>
</div>