@model project.Models.Brand;

@{
    ViewData["Title"] = "Sửa thương hiệu";
}

<div class="row">
    <div class="col-md-8 mx-auto d-flex align-items-stretch">
        <div class="card w-100 border-warning" style="border-top: 3px solid #dc3545;">
            <div class="card w-100">
                <div class="card-body p-6">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title fw-semibold mb-0 text-warning">
                            <i class="ti ti-edit"></i> Chỉnh Sửa Thương Hiệu
                        </h5>
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                            <i class="ti ti-arrow-left fs-4"></i> Quay lại
                        </a>
                    </div>

                    <form asp-action="sua" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="BrandId" />

                        <div class="mb-4">
                            <label asp-for="BrandName" class="form-label fw-semibold"></label>
                            <input asp-for="BrandName" class="form-control">
                            <span asp-validation-for="BrandName" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Origin" class="form-label fw-semibold"></label>
                            <input asp-for="Origin" class="form-control">
                            <span asp-validation-for="Origin" class="text-danger"></span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="submit" class="btn btn-warning d-flex align-items-center gap-2">
                                <i class="ti ti-device-floppy fs-4"></i> Cập Nhật
                            </button>

                            <a asp-action="Index" class="btn btn-light-secondary text-dark d-flex align-items-center gap-2">
                                <i class="ti ti-x fs-4"></i> Hủy Bỏ
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
