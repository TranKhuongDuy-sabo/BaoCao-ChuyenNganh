@model IEnumerable<project.Models.Brand>

@{
    ViewData["Title"] = "Quản Lý Thương Hiệu";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12 d-flex align-items-stretch">
            <div class="card w-100">
                <div class="card-body p-6">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title fw-semibold mb-0">Danh Sách Thương Hiệu</h5>

                        <div class="d-flex gap-2">
                            <form class="d-flex align-items-center">
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Tìm kiếm sản phẩm..." aria-label="Tìm kiếm" name="searchQuery">
                                    <button class="btn btn-outline-success" type="submit">
                                        <i class="ti ti-search fs-4"></i>
                                    </button>
                                </div>
                            </form>

                            <a href="/Admin/Brand/formThem" class="btn btn-primary d-flex align-items-center gap-2">
                                <i class="ti ti-plus fs-4"></i>
                                Thêm Sản Phẩm Mới
                            </a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        @if (TempData["Success"] != null)
                        {
                            <i class="ti ti-check fs-5 me-2"></i>
                            <strong>Thành công!</strong>
                            @TempData["Success"]
                        }
                        <table class="table text-nowrap mb-0 align-middle">
                            <thead class="text-dark fs-4">
                                <tr>
                                    <th>@Html.DisplayNameFor(Model => Model.BrandId)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.BrandName)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Origin)</th>
                                    <th class="border-bottom-0"><h6 class="fw-semibold mb-0">Thao Tác</h6></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.BrandId</td>
                                            <td>@item.BrandName</td>
                                            <td>@item.Origin</td>
                                            <td>
                                                <a href="/Admin/Brand/formSua?id=@item.BrandId" class="text-dark p-2">
                                                    <i class="ti ti-pencil fs-5"></i>
                                                </a>

                                                <a href="/Admin/Brand/formXoa?id=@item.BrandId" class="text-danger p-2">
                                                    <i class="ti ti-trash fs-5"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>