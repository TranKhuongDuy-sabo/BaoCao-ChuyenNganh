@model IEnumerable<project.Models.User>

@{
    ViewData["Title"] = "Quản Lý Người Dùng";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ti ti-ban me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ti ti-check me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12 d-flex align-items-stretch">
            <div class="card w-100">
                <div class="card-body p-6">

                    <div class="table-responsive">
                        @if (TempData["Success"] != null)
                        {
                            <i class="ti ti-check fs-5 me-2"></i>
                            <strong>Thành công!</strong>
                            @TempData["Success"]
                        }
                        <table class="table text-nowrap mb-0 align-middle">
                            <thead class="text-dark fs-4">
                                <tr>
                                    <th>@Html.DisplayNameFor(Model => Model.UserId)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Username)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Password)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Role)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.FullName)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Email)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Phone)</th>
                                    <th>@Html.DisplayNameFor(Model => Model.Address)</th>
                                    <th class="border-bottom-0"><h6 class="fw-semibold mb-0">Duyệt</h6></th>
                                    <th class="border-bottom-0"><h6 class="fw-semibold mb-0">Thao Tác</h6></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    foreach( var item in Model)
                                    {
                                        <tr>
                                            <td>@item.UserId</td>
                                            <td>@item.Username</td>
                                            <td>@item.Password</td>
                                            <td>@item.Role</td>
                                            <td>@item.FullName</td>
                                            <td>@item.Email</td>
                                            <td>@item.Phone</td>
                                            <td>@item.Address</td>
                                            <td>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input btn-active-user" type="checkbox"
                                                           data-id="@item.UserId"
                                                           @(item.IsActive ? "checked" : "")>
                                                </div>
                                            </td>
                                            <td>
                                                <a asp-area="Admin" asp-controller="User" asp-action="sua" asp-route-id="@item.UserId" class="text-dark p-2">
                                                    <i class="ti ti-pencil fs-5"></i>
                                                </a>

                                                <a asp-area="Admin" asp-controller="User" asp-action="Delete" asp-route-id="@item.UserId" class="text-danger p-2">
                                                    <i class="ti ti-trash fs-5"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.btn-active-user').change(function () {
                var btn = $(this);
                var id = btn.data('id');
                var trangThai = btn.prop('checked');

                $.ajax({
                    url: '/Admin/User/UpdateStatus',
                    type: 'POST',
                    data: { id: id, trangThai: trangThai },
                    success: function (rs) {
                        if (rs.success) {
                            console.log('Đã duyệt tài khoản!');
                        } else {
                            // Nếu lỗi (ví dụ cố tình khóa Admin) thì bật lại và báo lỗi
                            if(rs.message) alert(rs.message);
                            else alert('Lỗi!');

                            btn.prop('checked', !trangThai);
                        }
                    }
                });
            });
        });
    </script>
}
